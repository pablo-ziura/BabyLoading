        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma de nuevo tu identidad para eliminar la cuenta."
          }
        }
      }
    },
    "backup.error.sessionChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account changed during this operation. Please try again in the current account."
