    "backup.account.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes sync while the app is open and connected. Downloaded photos remain available offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se sincronizan mientras la app está abierta y conectada. Las fotos descargadas siguen disponibles sin conexión."
          }
        }
      }
    },
    "backup.delete.confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete my account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar mi cuenta"
          }
        }
      }
    },
    "backup.delete.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes your account and removes its data from this device after confirmation. If a recent sign-in is required, enter your password or confirm with Google."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción elimina tu cuenta de forma permanente y borra sus datos de este dispositivo tras la confirmación. Si se requiere un acceso reciente, introduce tu contraseña o confirma con Google."
          }
        }
      }
    },
    "backup.delete.title" : {
      "extractionState" : "manual",
      "localizations" : {
