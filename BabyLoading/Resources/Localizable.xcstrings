    "backup.error.credentials" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We could not verify your account. Check your email and password and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos podido verificar tu cuenta. Comprueba el correo y la contraseña e inténtalo de nuevo."
          }
        }
      }
    },
    "backup.error.emailAlreadyInUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This email is already linked to an account. Sign in with its existing provider or reset your password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este correo ya está vinculado a una cuenta. Accede con su proveedor o restablece la contraseña."
          }
        }
      }
    },
    "backup.error.invalidData" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An item could not be prepared or restored. Its original local file is preserved. You can retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido preparar o restaurar un elemento. Su archivo local original se conserva. Puedes reintentarlo."
          }
        }
      }
    },
    "backup.error.missingImage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An image file is unavailable. Keep the app open to retry restoring it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está disponible un archivo de imagen. Mantén la app abierta para reintentar su restauración."
          }
        }
      }
    },
    "backup.error.network" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for a connection. Your local photos are safe; backup will retry automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando conexión. Tus fotos locales están guardadas; el respaldo se reintentará automáticamente."
          }
        }
      }
    },
    "backup.error.permissionDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup access was denied. Your local data is unchanged. Try signing in again or contact support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha denegado el acceso al respaldo. Tus datos locales siguen intactos. Inicia sesión de nuevo o contacta con soporte."
          }
        }
      }
    },
    "backup.error.quotaExceeded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup service has reached a limit. Your local data is saved. Try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de respaldo ha alcanzado un límite. Tus datos locales están guardados. Inténtalo más tarde."
          }
        }
      }
    },
    "backup.error.recentLoginRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
